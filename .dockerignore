# Keep the build context minimal and secret-free.
.git
.github
.vercel
.vscode
.idea
.agents
.cursor
.continue
.kiro
.roo
.clinerules
.freebuff
node_modules
dist
coverage
*.log

# Secrets & local env — NEVER bake into image
.env
.env.*
!.env.example

# Migration artifacts & database dumps
migration/
*.dump
*.sql.gz
26052026-backup-complete.sql
sb-backups/
**/backup/

# Local storage (mounted as volume at runtime)
storage/

# Dev-only directories not needed at runtime
docs/
supabase/
telemetry-*.json
auth.json
config.json

# NOTE: plugins/ TIDAK di-ignore — vite.config.js mengimpor plugin dari
# ./plugins/ saat build (vite-plugin-react-inline-editor, edit-mode,
# iframe-route-restoration, selection-mode). Tanpa itu, builder stage gagal.
