# ==============================================================================
# KR APP - Production Runtime Environment Variables
# ==============================================================================

# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://admin.kakaramaroom.com

# PostgreSQL Target
POSTGRES_USER=kr_user
POSTGRES_PASSWORD=kr_secure_password_2026
POSTGRES_DB=kr_production
DATABASE_URL=postgresql://kr_user:kr_secure_password_2026@postgres:5432/kr_production

# Storage Driver (local | s3 | r2)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/storage

# Optional S3 / Cloudflare R2
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_DOMAIN=

# Authentication Secret
JWT_SECRET=super_secret_production_jwt_key_at_least_32_characters

# Web Push Notification (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kakaramaroom.com

# ==============================================================================
# Migration Only (DO NOT USE IN NORMAL PRODUCTION RUNTIME)
# ==============================================================================
# MIGRATION_SUPABASE_DB_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres
# MIGRATION_VERCEL_BLOB_TOKEN=vercel_blob_rw_...
# MIGRATION_TARGET_DB_URL=postgresql://kr_user:kr_secure_password_2026@127.0.0.1:5432/kr_production
