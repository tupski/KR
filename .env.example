# ==============================================================================
# KR APP — environment template. Copy to .env and fill real values.
# .env is git-ignored. NEVER commit real secrets.
# Nilai kosong di bawah WAJIB diisi operator sebelum produksi.
# ==============================================================================

# ------------------------------------------------------------------------------
# RUNTIME (dibutuhkan aplikasi produksi)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://admin.kakaramaroom.com

# PostgreSQL target
POSTGRES_USER=kr_user
POSTGRES_PASSWORD=
POSTGRES_DB=kr_production
# DATABASE_URL dipakai aplikasi. Di Docker compose, host = nama service `postgres`:
DATABASE_URL=postgresql://kr_user:your_p…word@postgres:5432/kr_production
# Jalankan server di luar Docker? ganti host menjadi 127.0.0.1.

# Auth — secret minimal 32 karakter acak (server menolak start jika pendek)
JWT_SECRET=
JWT_EXPIRES_IN=12h
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Pendaftaran publik dinonaktifkan; akun dibuat admin.
AUTH_ALLOW_PUBLIC_REGISTER=false

# CORS / CSRF — origin diizinkan, pisah koma. Kosong = hanya APP_URL.
CORS_ORIGINS=

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE=10485760
#UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp,application/pdf
#UPLOAD_ALLOWED_EXT=.jpg,.jpeg,.png,.webp,.pdf

# Optional S3 / Cloudflare R2 (STORAGE_DRIVER=s3 atau r2)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_DOMAIN=

# Cron / notifications
NOTIF_CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kakaramaroom.com

# Frontend build-time (Vite) — mode API:
#   native   = SPA memakai Node API self-hosted (target akhir)
#   supabase = SPA memakai Supabase langsung (legacy, masa transisi)
VITE_API_MODE=native
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# ------------------------------------------------------------------------------
# MIGRATION ONLY — TIDAK dibutuhkan runtime produksi normal
# ------------------------------------------------------------------------------
MIGRATION_SUPABASE_DB_URL=
MIGRATION_TARGET_DB_URL=
MIGRATION_VERCEL_BLOB_TOKEN=
MIGRATION_CONCURRENCY=3
MIGRATION_MAX_RETRIES=3
