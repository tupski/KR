# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION (CLIENT-SIDE)
# ═══════════════════════════════════════════════════════════════════════════════
VITE_SUPABASE_URL=https://hhyvvdumtmvlnzklsbed.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-supabase-publishable-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# SUPABASE CONFIGURATION (SERVER-SIDE ONLY)
# Required for api/upload.js and other backend services
# ═══════════════════════════════════════════════════════════════════════════════
SUPABASE_URL=https://hhyvvdumtmvlnzklsbed.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# STORAGE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
STORAGE_DRIVER=r2
VITE_STORAGE_PROVIDER=r2

# ═══════════════════════════════════════════════════════════════════════════════
# CLOUDFLARE R2 CONFIGURATION (SERVER-SIDE ONLY)
# Required for file uploads via api/upload.js
# ═══════════════════════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=artupski-drive
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto

# ═══════════════════════════════════════════════════════════════════════════════
# R2 PUBLIC BASE URL (CLIENT-SIDE OK)
# Used to construct public URLs for uploaded files
# ═══════════════════════════════════════════════════════════════════════════════
VITE_R2_PUBLIC_BASE_URL=https://cdn.artupski.com

# ═══════════════════════════════════════════════════════════════════════════════
# LEGACY VERCEL BLOB (KEEP for backward compatibility)
# ═══════════════════════════════════════════════════════════════════════════════
BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token
VERCEL_BLOB_BASE_URL=https://xxx.private.blob.vercel-storage.com

# ═══════════════════════════════════════════════════════════════════════════════
# UPLOAD SECURITY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://admin.kakaramaroom.com,https://kr-gamma.vercel.app
MAX_UPLOAD_SIZE_MB=10
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=15
