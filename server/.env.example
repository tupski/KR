# Server self-host — contoh env. Salin ke .env dan isi.
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/kakarama

# Auth
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_TTL=7d
COOKIE_SECURE=false

# Storage provider: r2 | vercel_blob | supabase
STORAGE_PROVIDER=r2

# r2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=transaction_receipts
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=

# vercel_blob
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_BASE_URL=

# supabase storage (server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=transaction_receipts

# opsional
BODY_LIMIT=10mb
DIST_DIR=dist